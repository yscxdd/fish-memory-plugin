{
  "name": "dsh-fish-memory",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Local-first long-term memory for AI companions: markdown memory + append-only JSONL transcripts, budgeted prompt injection, source-traceable, zero dependencies. 给 AI 伴侣的本地长期记忆插件（无向量库、无遥测）",
  "keywords": [
    "ai-memory",
    "long-term-memory",
    "llm",
    "ai-companion",
    "local-first",
    "markdown",
    "jsonl",
    "memory",
    "prompt-injection",
    "context-engineering",
    "zero-dependency",
    "chatbot",
    "personal-ai",
    "dsh",
    "deepseek-harness"
  ],
  "main": "lib/index.js",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "files": [
    "lib/**",
    "scripts/**",
    "samples/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "verify": "node scripts/memory.mjs verify",
    "hostcheck": "node scripts/memory.mjs hostcheck",
    "gold": "node scripts/memory.mjs gold",
    "selfcheck": "node scripts/selfcheck.mjs",
    "preflight": "node scripts/preflight-open.mjs",
    "audit": "node scripts/audit-self.mjs",
    "preview": "node scripts/preview.mjs ../fish-memory",
    "sync": "node scripts/sync.mjs",
    "memory": "node scripts/memory.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "verified": "0.2.1-rc.5",
      "surface": 17,
      "updated": "2026-10-30",
      "api": "lib/host.js 的 HOST_POINTS（17 条）",
      "howToCheck": "memory hostcheck（静态） / memory compat（快照对比 + 尸检）"
    }
  },
  "license": "MIT"
}
